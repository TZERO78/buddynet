<!-- service control script -->
<FILE Name="/etc/rc.d/rc.buddynet" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
# rc.buddynet — control the BuddyNet tunnel (buddy role)
CFG=/boot/config/plugins/buddynet/buddynet.cfg
BIN=/usr/local/bin/buddynet
# Identity key, trust store and peer cache live on the array (real 0600 perms),
# not the FAT flash. Requires the array to be started — the service runs on the
# array event.
STATE=/mnt/user/appdata/buddynet
PIDFILE=/var/run/buddynet.pid
LOG=/var/log/buddynet.log
[ -f "$CFG" ] && . "$CFG"

# Trim stray leading/trailing whitespace from values (a space pasted into a
# field would otherwise break e.g. DNS resolution of the server address).
trim() { local s="$*"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
SERVER="$(trim "${SERVER:-}")"; SERVER_KEY="$(trim "${SERVER_KEY:-}")"; TOKEN="$(trim "${TOKEN:-}")"
TOKEN_FILE="$(trim "${TOKEN_FILE:-}")"; PEER_KEY="$(trim "${PEER_KEY:-}")"
LISTEN="$(trim "${LISTEN:-}")"; FORWARD="$(trim "${FORWARD:-}")"
NAME="$(trim "${NAME:-}")"; DNS="$(trim "${DNS:-}")"; LAZY="$(trim "${LAZY:-}")"
EXPOSE="$(trim "${EXPOSE:-}")"
# Direct mode (no handshake server). MODE defaults to coordinator so an existing
# config that predates this field keeps behaving exactly as before.
MODE="$(trim "${MODE:-coordinator}")"
PEER_ENDPOINT="$(trim "${PEER_ENDPOINT:-}")"; LISTEN_PORT="$(trim "${LISTEN_PORT:-}")"

is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

install_lang() {
  # Our German dictionary for the SMB section — picked up by the webGUI's
  # parse_plugin() when a German language pack is active. Re-copied here because
  # boot-time install order of plugin vs language pack is not guaranteed.
  if [ -d /usr/local/emhttp/languages/de_DE ] && [ -f /boot/config/plugins/buddynet/lang-de_DE-buddynet.txt ]; then
    cp -f /boot/config/plugins/buddynet/lang-de_DE-buddynet.txt /usr/local/emhttp/languages/de_DE/buddynet.txt
    rm -f /usr/local/emhttp/languages/de_DE/buddynet.dot
  fi
}

start() {
  install_lang
  [ "$SERVICE" = "enable" ] || { echo "disabled"; return 0; }
  is_running && { echo "running"; return 0; }
  [ -x "$BIN" ] || { echo "binary missing"; return 1; }
  mkdir -p "$STATE" 2>/dev/null || { echo "appdata unavailable (is the array started?)"; return 1; }
  # Prefer the token from a file on the array (real 0600 perms) over the flash
  # cfg value; /boot is FAT and cannot enforce permissions. Only override when the
  # file is non-empty and readable (an empty file must not blank out the token).
  # Resolved before the args are built because the pin below depends on WHICH
  # kind of invite this is.
  tok="$TOKEN"
  if [ -n "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ] && [ -r "$TOKEN_FILE" ]; then
    ftok="$(trim "$(tr -d '\r\n' < "$TOKEN_FILE")")"
    [ -n "$ftok" ] && tok="$ftok"
  fi
  # Headless: there is no terminal to compare a first-contact SAS, so run
  # --no-interactive (an unknown buddy key is refused, never learned blind).
  args=(--role=buddy --key "$STATE/id.key" --known-peers "$STATE/known_peers"
        --peers "$STATE/peers.json" --no-interactive)
  if [ "$MODE" = "direct" ]; then
    # DIRECT MODE — no handshake server at all. Removing the server also removes
    # the signed roster, the SAS and the relay ticket, so the pinned key is the
    # ENTIRE authentication. Both checks below are refusals, not warnings: the
    # daemon would exit 2 anyway, and a message here says which FIELD is wrong
    # rather than which flag.
    if [ -z "$PEER_KEY" ]; then
      echo "ERROR: Direct mode needs the Buddy key — it is the only thing that authenticates your buddy when there is no handshake server. Paste your buddy's identity (they get it from 'Your identity' on their own page)." >>"$LOG"
      echo "needs a buddy key"; return 1
    fi
    if [ -z "$PEER_ENDPOINT" ] && [ -z "$LISTEN_PORT" ]; then
      echo "ERROR: Direct mode needs either a Buddy endpoint (to dial your buddy) or a Listen port (to be dialled by them). With neither there is no way for the two to meet." >>"$LOG"
      echo "needs an endpoint or a listen port"; return 1
    fi
    args+=(--direct --peer-key "$PEER_KEY")
    [ -n "$PEER_ENDPOINT" ] && args+=(--peer-endpoint "$PEER_ENDPOINT")
    [ -n "$LISTEN_PORT" ]   && args+=(--listen-port "$LISTEN_PORT")
    # There is no rendezvous in this mode, and BUDDYNET_JOIN is the environment
    # form of --join, which --direct refuses. Drop any configured invite rather
    # than handing the daemon a combination it will exit 2 on.
    [ -n "$tok" ] && echo "NOTE: an invite is configured but direct mode does not use one (there is no server to redeem it at) — ignoring it." >>"$LOG"
    tok=""
  else
    args+=(--server "$SERVER" --server-key "$SERVER_KEY")
    # Where the pin comes from depends on the invite: a bnet1.… invite CARRIES the
    # inviter's identity and pins it by itself, so the Buddy key is optional there.
    # Only a bare legacy token has nothing to pin, and headless has no SAS prompt —
    # that is the case where a missing Buddy key really does mean "refused".
    if [ -n "$PEER_KEY" ]; then
      args+=(--peer-key "$PEER_KEY")
    else
      case "$tok" in
        bnet1.*)
          echo "NOTE: no Buddy key set — not needed here: the bnet1.… invite carries your buddy's identity and is pinned from it." >>"$LOG"
          ;;
        *)
          echo "WARNING: no Buddy key set and the invite is a bare token, which carries no identity — headless has no SAS prompt, so the connection will be refused. Either paste the full bnet1.… invite your buddy generated, or set the Buddy key (your buddy's identity) to pin it." >>"$LOG"
          ;;
      esac
    fi
  fi
  [ -n "$LISTEN" ]  && args+=(-L "$LISTEN")
  [ -n "$FORWARD" ] && args+=(-forward "$FORWARD")
  # BuddyDNS: self-asserted .buddy name and/or the stub resolver (root here, so
  # the privileged 127.0.0.153:53 bind succeeds).
  [ -n "$NAME" ] && args+=(--name "$NAME")
  [ "$DNS" = "enable" ] && args+=(--dns)
  # The control plane is always QUIC/TLS 1.3 since v5 — there is no plain-UDP
  # transport left to choose, so no flag to pass.
  # Lazy needs -L (there is no listener to hold open without it); skip + warn.
  if [ "$LAZY" = "enable" ]; then
    if [ -n "$LISTEN" ]; then
      args+=(--lazy)
    else
      echo "WARNING: Lazy tunnel is enabled but no -L (Expose local port) is set — ignoring --lazy." >>"$LOG"
    fi
  fi
  # WireGuard data plane: the peer tunnel runs over kernel WireGuard (the partner
  # is reachable natively at its VIP). Control plane stays QUIC/plain.
  if [ "$WIREGUARD" = "enable" ]; then
    args+=(--wireguard)
    # Scoped exposure: empty EXPOSE = fail-closed (buddy reaches nothing here).
    # Say so in the log so the posture is visible, mirroring the daemon's own line.
    if [ -n "$EXPOSE" ]; then
      args+=(--expose "$EXPOSE")
    else
      echo "NOTE: WireGuard is scoped by default — no Exposed ports set, so your buddy reaches NOTHING on this server (fail-closed). Set e.g. 873, or 'all' for explicit whole-host access." >>"$LOG"
    fi
  fi
  # The invite goes in via the environment (BUDDYNET_JOIN), not argv, so it does
  # not show up in ps for every user on the box. Resolved further up.
  BUDDYNET_JOIN="$tok" nohup "$BIN" "${args[@]}" >>"$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  echo "started"
}
stop() { is_running && kill "$(cat "$PIDFILE")" 2>/dev/null; rm -f "$PIDFILE"; echo "stopped"; }
# really delete a file: shred if available (best effort on SSD/CoW), else rm
wipe() { [ -f "$1" ] && { shred -u "$1" 2>/dev/null || rm -f "$1"; }; }
# The buddy this node is paired with: the pinned key from the cfg, else the key
# on the stored session line (field 2 of a 3-field line in known_peers).
buddy_key() {
  local k="$PEER_KEY"
  if [ -z "$k" ] && [ -r "$STATE/known_peers" ]; then
    k="$(awk 'NF>=3 {print $2; exit}' "$STATE/known_peers")"
  fi
  printf '%s' "$k"
}
# The invite currently configured (file wins over the flash cfg, as in start()).
invite_token() {
  local t="$TOKEN"
  if [ -n "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ] && [ -r "$TOKEN_FILE" ]; then
    local ft; ft="$(trim "$(tr -d '\r\n' < "$TOKEN_FILE")")"
    [ -n "$ft" ] && t="$ft"
  fi
  printf '%s' "$t"
}
# Forget buddy = REVOKE. Wiping known_peers was never a revocation: PEER_KEY and
# the invite live in buddynet.cfg on the flash, untouched by the wipe, so the
# service came straight back up with the same pin and the same token and the same
# buddy re-paired within seconds. `peers remove` records the key on the
# revocation list, which the daemon refuses at every attempt, and drops the
# stored session — and the service stays STOPPED, because this node now has no
# buddy to connect to.
forget_buddy() {
  local k; k="$(buddy_key)"
  stop
  if [ -n "$k" ] && [ -x "$BIN" ]; then
    "$BIN" --known-peers "$STATE/known_peers" peers remove "$k" || echo "revoke failed — check $LOG"
  else
    wipe "$STATE/known_peers"
    echo "no buddy key found (nothing paired yet) — trust store cleared"
  fi
  echo "the service stays stopped: this node has no buddy now."
  echo "to pair again: paste a NEW invite and the buddy key, then press \"Allow buddy again\"."
}
# The deliberate counterpart. It refuses unless a key AND an invite are
# configured, so the revocation is never lifted before there is something new to
# pin — the window between "allowed again" and "pinned again" stays shut.
allow_buddy() {
  local k t; k="$(buddy_key)"; t="$(invite_token)"
  [ -n "$k" ] || { echo "no Buddy key configured — paste your buddy's key first"; return 1; }
  [ -n "$t" ] || { echo "no invite configured — paste the NEW invite first (an old one will not pair)"; return 1; }
  [ -x "$BIN" ] || { echo "binary missing"; return 1; }
  "$BIN" --known-peers "$STATE/known_peers" peers allow "$k" || return 1
  stop; sleep 1; start
}
# reset_identity may delete everything, revocation list included: the identity is
# gone, so there is nothing left for a tombstone to protect.
reset_identity() { stop; wipe "$STATE/id.key"; wipe "$STATE/known_peers"; wipe "$STATE/known_peers.revoked"; echo "identity + trust store deleted"; sleep 1; start; }
# rate: connection counts + throughput (bytes/sec) per direction, measured on the
# loopback forwarded sockets (-L listener = "out" path, -forward target = "in").
rate() {
  local lp="${LISTEN##*:}" fp="${FORWARD##*:}"
  # ports come from the (user-written) cfg — keep only digits before they reach ss
  lp="${lp//[^0-9]/}"; fp="${fp//[^0-9]/}"
  bytes() { ss -tinH state established "$1" 2>/dev/null | grep -oE 'bytes_(sent|received):[0-9]+' | awk -F: '{s+=$2}END{print s+0}'; }
  count() { ss -tnH  state established "$1" 2>/dev/null | grep -c . ; }
  local oc=0 ic=0 o1=0 i1=0 o2=0 i2=0
  [ -n "$lp" ] && { oc=$(count "sport = :$lp"); o1=$(bytes "sport = :$lp"); }
  [ -n "$fp" ] && { ic=$(count "dport = :$fp"); i1=$(bytes "dport = :$fp"); }
  sleep 1
  [ -n "$lp" ] && o2=$(bytes "sport = :$lp")
  [ -n "$fp" ] && i2=$(bytes "dport = :$fp")
  echo "oc=$oc ic=$ic out=$((o2-o1)) in=$((i2-i1))"
}
case "$1" in
  start)         start ;;
  stop)          stop ;;
  restart)       stop; sleep 1; start ;;
  status)        is_running && echo running || echo stopped ;;
  rate)          rate ;;
  forget-buddy)  forget_buddy ;;
  allow-buddy)   allow_buddy ;;
  reset-identity) reset_identity ;;
  *)             echo "usage: $0 {start|stop|restart|status|rate|forget-buddy|allow-buddy|reset-identity}" ;;
esac
]]>
</INLINE>
</FILE>

<!-- German strings for the SMB section. Loaded by the webGUI's own
     parse_plugin() mechanism from languages/<locale>/buddynet.txt when a German
     language pack is installed and active; falls back to English otherwise.
     Kept on flash; copied into place at install and service start. -->
<FILE Name="&plgPATH;/lang-de_DE-buddynet.txt">
<INLINE>
<![CDATA[
; BuddyNet plugin — deutsche Übersetzung (SMB-Sektion).
; Schlüssel = englischer Text nach den Regeln von Translations.php
; (Zeichen ?{}|&~![]()/\:*^."' entfernt, Mehrfach-Leerzeichen zusammengefasst).
SMB access for your buddy — expose Samba over the tunnel=SMB-Zugriff für deinen Buddy — Samba über den Tunnel freigeben
needs WireGuard; selecting Enabled fills in WireGuard + port 445 above, visibly=braucht WireGuard; bei Aktivierung werden oben sichtbar WireGuard + Port 445 eingetragen
Share user for your buddy=Share-User für deinen Buddy
an Unraid user YOU create under Users — this plugin never creates or changes users=ein Unraid-User, den DU unter Users anlegst — dieses Plugin legt nie User an und ändert keine
With this enabled your buddy reaches exactly ONE thing on this server, Samba on port 445, and inside Samba only the shares you grant to the share user Everything else stays invisible, fail-closed BuddyNet only carries the connection — the shares, users and rights are Unraids own=Mit dieser Einstellung erreicht dein Buddy auf diesem Server genau EINE Sache, Samba auf Port 445, und innerhalb von Samba nur die Shares, die du dem Share-User gibst. Alles andere bleibt unsichtbar, fail-closed. BuddyNet transportiert nur die Verbindung — Shares, User und Rechte sind Unraids eigene
Folder rights are plain Unraid set the share to Secure or Private and grant the share user Read-only or Read-Write under Shares=Ordner-Rechte sind pures Unraid — stelle den Share auf Secure oder Private und vergib dem Share-User unter Shares Read-only oder Read-Write
Public shares are visible to your buddy=Public-Shares sind für deinen Buddy sichtbar
These shares are set to Public, so ANY SMB client — including your buddy once the tunnel is up — can open them=Diese Shares stehen auf Public — JEDER SMB-Client kann sie öffnen, auch dein Buddy, sobald der Tunnel steht
If that is not intended, set them to Secure or Private under Shares New Unraid shares are Public by default=Falls das nicht gewollt ist, stelle sie unter Shares auf Secure oder Private. Neue Unraid-Shares sind standardmäßig Public
Setup — three steps, all with Unraids own tools=Einrichtung — drei Schritte, alles mit Unraids Bordmitteln
1 Create the user under Users — Add User; this plugin never creates or changes users=1. Lege den User unter Users — Add User an; dieses Plugin legt nie User an und ändert keine
2 Grant that user access per share under Shares — SMB Security, Secure or Private=2. Vergib dem User pro Share Rechte unter Shares — SMB Security, Secure oder Private
3 Send the SMB password to your buddy over a channel you trust The password only selects the Unraid user; the security boundary is the pinned, encrypted tunnel itself=3. Schick deinem Buddy das SMB-Passwort über einen Kanal, dem du vertraust. Das Passwort wählt nur den Unraid-User aus; die Sicherheitsgrenze ist der gepinnte, verschlüsselte Tunnel selbst
What your buddy enters on the other side=Was dein Buddy auf der anderen Seite einträgt
Server=Server
User=User
On Unraid use the Unassigned Devices plugin — Add Remote SMB Share Prefer a soft mount a dropped tunnel then gives errors instead of a hanging WebGUI=Auf Unraid nimm das Unassigned-Devices-Plugin — Add Remote SMB Share. Bevorzuge einen Soft-Mount — ein abgerissener Tunnel gibt dann Fehler statt einer hängenden WebGUI
Unraid user=Unraid-User
exists=existiert
does not exist yet — create it under Users=existiert noch nicht — lege ihn unter Users an
]]>
</INLINE>
</FILE>

<!-- start on array-up (so a token file on /mnt/user is available), stop on array-down -->
<FILE Name="&emhttp;/event/started" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
/etc/rc.d/rc.buddynet restart >/dev/null 2>&1 &
]]>
</INLINE>
</FILE>

<FILE Name="&emhttp;/event/stopping" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
/etc/rc.d/rc.buddynet stop >/dev/null 2>&1
]]>
</INLINE>
</FILE>

<!-- install: fetch binary (once, persisted on flash), seed config, start -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
<![CDATA[
set -e
PLG=/boot/config/plugins/buddynet
mkdir -p "$PLG"

# NOTE: entities are NOT expanded inside <FILE> CDATA on Unraid, so the binary
# version and URL are hard-coded here on purpose.
# MAINTAINER: bump both together on each new release (tag -> release.yml build).
BINVER="v5.5.0"
BINURL="https://github.com/TZERO78/buddynet/releases/download/${BINVER}/buddynet-linux-amd64"
# SHA256 of the release binary; verified on every install so a corrupted or
# tampered download is never installed. Matches buddynet-linux-amd64.sha256 of
# the BINVER release — bump both together on each new release.
BINSHA="4bfc7714d48ab191435e327acd33c0435333634a7bb3be8d1b67a7480de1db5b"
verify() { echo "$BINSHA  $1" | sha256sum -c --status 2>/dev/null; }

# Download the buddynet binary to flash (only if missing or its checksum is wrong).
if [ ! -s "$PLG/buddynet" ] || ! verify "$PLG/buddynet"; then
  echo "Downloading buddynet ${BINVER} ..."
  wget -qO "$PLG/buddynet" "$BINURL" || { echo "download failed"; rm -f "$PLG/buddynet"; exit 1; }
fi
if ! verify "$PLG/buddynet"; then
  echo "checksum mismatch — refusing to install (expected $BINSHA)"
  rm -f "$PLG/buddynet"; exit 1
fi
install -m0755 "$PLG/buddynet" /usr/local/bin/buddynet
chmod 0755 /etc/rc.d/rc.buddynet

# Install the plugin logo (used by the Tools tile and the Plugins page).
EMHTTP=/usr/local/emhttp/plugins/buddynet
mkdir -p "$EMHTTP"
base64 -d > "$EMHTTP/buddynet.png" <<'PNG'
