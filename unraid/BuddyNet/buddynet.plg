# Seed a default config on first install only (never overwrite the user's).
if [ ! -f "$PLG/buddynet.cfg" ]; then
  cat > "$PLG/buddynet.cfg" <<'CFG'
SERVICE="disable"
# coordinator = the usual setup (a handshake server introduces the two of you).
# direct      = no server at all; you configure your buddy's address and pin
#               their key. Existing configs have no MODE line and default to
#               coordinator, so nothing changes for them.
MODE="coordinator"
SERVER=""
SERVER_KEY=""
TOKEN=""
# Default to a token file on the array (real 0600) rather than the FAT flash.
# Create it (see the Secret note on the page); the plain TOKEN field is a
# testing fallback used only when this file is absent.
TOKEN_FILE="/mnt/user/appdata/buddynet/token"
PEER_KEY=""
# Direct mode only (ignored when MODE=coordinator).
PEER_ENDPOINT=""
LISTEN_PORT=""
LISTEN="127.0.0.1:9000"
FORWARD="127.0.0.1:873"
BUDDYSHARE="disable"
SHARE_USER=""
CFG
fi
chmod 0600 "$PLG/buddynet.cfg"

# German strings for the SMB section (webGUI parse_plugin mechanism);
# silently skipped when no German language pack is installed.
if [ -d /usr/local/emhttp/languages/de_DE ] && [ -f "$PLG/lang-de_DE-buddynet.txt" ]; then
  cp -f "$PLG/lang-de_DE-buddynet.txt" /usr/local/emhttp/languages/de_DE/buddynet.txt
  rm -f /usr/local/emhttp/languages/de_DE/buddynet.dot
fi

/etc/rc.d/rc.buddynet restart >/dev/null 2>&1 || true
echo ""
echo "BuddyNet installed. Configure it under Tools -> BuddyNet."
]]>
</INLINE>
</FILE>

<!-- remove: stop and clean up -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
/etc/rc.d/rc.buddynet stop >/dev/null 2>&1 || true
rm -f /usr/local/bin/buddynet /etc/rc.d/rc.buddynet
rm -rf /usr/local/emhttp/plugins/buddynet
rm -f /usr/local/emhttp/languages/*/buddynet.txt /usr/local/emhttp/languages/*/buddynet.dot
# Clean uninstall: remove the config + binary from flash...
rm -rf /boot/config/plugins/buddynet
# ...and the identity key + trust store + peer cache from the array (leave a
# user-placed token file and the appdata dir itself alone). Array may be down here.
rm -f /mnt/user/appdata/buddynet/id.key /mnt/user/appdata/buddynet/known_peers \
      /mnt/user/appdata/buddynet/known_peers.revoked /mnt/user/appdata/buddynet/known_peers.lock \
      /mnt/user/appdata/buddynet/peers.json 2>/dev/null || true
echo "BuddyNet removed. Config (flash) and identity/trust/cache (appdata) deleted."
]]>
</INLINE>
</FILE>

</PLUGIN>
