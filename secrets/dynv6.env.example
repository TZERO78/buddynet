# Template for secrets/dynv6.env — copy, fill in, and never commit the copy.
# Used only by lab/test-direct-dynv6.sh. Without it that lab skips itself.

# The zone you created at the provider. The zone name IS the record: you do not
# add an A/AAAA entry by hand, the update request below sets it.
DYNV6_HOST=your-name.dynv6.net

# The update token from the provider. This is a credential — it can repoint the
# record your buddies resolve. It cannot impersonate anyone (a direct-mode buddy
# authenticates by pinned key), but it can deny you service.
DYNV6_TOKEN=replace-me

# Optional: the UDP port the lab's listening buddy binds (default 51844).
#DYNV6_PORT=51844
