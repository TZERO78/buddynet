[10.003486, "o", "\u001b[H\u001b[2J\u001b[3J"]
[10.003902, "o", "\u001b[1;36m┌──────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1;36m│  BuddyNet — direct mode: no server at all                     │\u001b[0m\r\n\u001b[1;36m│  no matchmaking · no token · no third party in the path       │\u001b[0m\r\n\u001b[1;36m└──────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[11.305246, "o", "\u001b[2m# 1) Each side prints its identity — you swap these two lines by phone or Signal.\u001b[0m\r\n"]
