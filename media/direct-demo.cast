[26.708927, "o", "\u001b[1;36m<!DOCTYPE HTML>\u001b[0m\r\n\r\n"]
[27.710357, "o", "\u001b[1;33m  Two machines, two pinned keys, one UDP port.\u001b[0m\r\n\u001b[1;33m  The address only finds your buddy — the KEY decides it is them.\u001b[0m\r\n"]
