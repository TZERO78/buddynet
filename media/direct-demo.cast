[21.898946, "o", "\u001b[2mCONNECTED: role=buddy partner=tID+md3t vip=10.66.90.55 via=\"direct (configured endpoint)\"\u001b[0m\r\n\r\n"]
[22.900543, "o", "\u001b[2m#    (here 'localhost' — in your setup a DynDNS name. It is re-resolved on\u001b[0m\r\n"]
[23.602426, "o", "\u001b[2m#     every attempt, so a changing address needs no reconfiguration.)\u001b[0m\r\n"]
[24.303838, "o", "\r\n"]
[25.50541, "o", "\u001b[2m# The NAS service is now reachable on the laptop, through the tunnel:\u001b[0m\r\n"]
