[0.023353, "o", "\r\ncreated a new identity at /tmp/A.key\r\n  Buddies pin this key — hand it to them as --server-key (handshake server)\r\n  or --peer-key (buddy). Back the file up: losing it changes this node's\r\n  identity AND its virtual IP, and everyone has to re-pin.\r\n"]
[0.02755, "o", "\r\ncreated a new identity at /tmp/B.key\r\n  Buddies pin this key — hand it to them as --server-key (handshake server)\r\n  or --peer-key (buddy). Back the file up: losing it changes this node's\r\n  identity AND its virtual IP, and everyone has to re-pin.\r\n"]
[0.242002, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.24234, "o", "\u001b[1;36m┌──────────────────────────────────────────────────────────────┐\u001b[0m\r\n\u001b[1;36m│  BuddyNet — stand up your overlay in 3 steps                  │\u001b[0m\r\n\u001b[1;36m│  VPS coordinates · two NATed machines · a DIRECT tunnel       │\u001b[0m\r\n\u001b[1;36m└──────────────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
