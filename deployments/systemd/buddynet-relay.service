[Unit]
Description=BuddyNet relay (blind encrypted-packet forwarder)
Documentation=https://github.com/TZERO78/buddynet
# time-sync.target: the relay's bind cookie is bound to a time epoch, so wait
# for NTP/time-sync before serving.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# Crash-loop circuit breaker: stop retrying after 5 failed starts within 60s
# (a deterministic fault) instead of restarting forever under Restart=on-failure.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Listen address/port is configurable without editing this unit:
#   sudo systemctl edit buddynet-relay
Environment=BUDDYNET_RELAY_LISTEN=[::]:51821
# AUTHORIZATION POLICY — REQUIRED. A relay refuses to start without one: it
# carries your bandwidth, and a stranger who hoards its capacity takes away the
# fallback the two people it was built for need. Set BOTH of these with
#   sudo systemctl edit buddynet-relay
# to the handshake server's public key (`buddynet --key ... identity`) and the
# id you generated once with `buddynet gen-relay-id` — the SAME id the handshake
# server is started with (--relay-id).
#
#   [Service]
#   Environment=BUDDYNET_RELAY_POLICY=--server-key SERVER_KEY --relay-id RELAY_ID
#
# Alternatively, for a relay only fixed networks reach:
#   Environment=BUDDYNET_RELAY_POLICY=--allow-cidr 203.0.113.0/24
# (0.0.0.0/0 and ::/0 are refused — an open relay is not a configuration.)
Environment=BUDDYNET_RELAY_POLICY=
ExecStart=/usr/local/bin/buddynet --role=relay --listen ${BUDDYNET_RELAY_LISTEN} $BUDDYNET_RELAY_POLICY
Restart=on-failure
RestartSec=2

# A relay holds no identity key and no persistent state — it forwards opaque
# encrypted datagrams between session legs and never sees content. In ticket
# mode it holds only the handshake server's PUBLIC key: it can verify that a
# session was authorised, and can never authorise one.
#
# Running the relay as its OWN unit (rather than --role=handshake,relay in one
# process) is what keeps that true: in the combined process the server's signing
# key sits in the same memory that parses relay packets.

# --- Logging: isolate and cap so a flood cannot fill the disk ---------------
# SyslogIdentifier distinguishes this role within the namespace
# (journalctl --namespace=buddynet -t buddynet-relay). journal is the default.
LogNamespace=buddynet
StandardOutput=journal
StandardError=journal
SyslogIdentifier=buddynet-relay
LogRateLimitIntervalSec=10s
LogRateLimitBurst=200

# --- Identity: ephemeral, unprivileged, no home, no shell -------------------
# Port 51821 is > 1024, so NO capabilities are needed to bind it.
DynamicUser=yes
PrivateUsers=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
KeyringMode=private
UMask=0077

# --- Filesystem: the process needs nothing on disk --------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateMounts=yes
ProtectProc=invisible
ProcSubset=pid

# --- Kernel / host isolation ------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# --- Syscall / address-family allowlist -------------------------------------
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# --- Resource ceilings (defense in depth vs. DoS) ---------------------------
MemoryMax=128M
TasksMax=64
LimitNOFILE=4096
# No core dumps (defense in depth; the relay holds no key but forwards traffic).
LimitCORE=0

[Install]
WantedBy=multi-user.target
