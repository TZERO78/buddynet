# Copy to .env and adjust as needed. Unset variables fall back to the documented
# BuddyNet defaults, so an empty .env is fine.
#
#   cp deployments/.env.example deployments/.env

# UDP port for the handshake (matchmaking) server. Default: 51820
BUDDYNET_HANDSHAKE_PORT=51820

# UDP port for the blind relay. Default: 51821
BUDDYNET_RELAY_PORT=51821

# REQUIRED by docker-compose.yml (both services refuse to start without them):
#
# The relay id — mint ONCE with `buddynet gen-relay-id` and set the same value
# here for both services. Not a secret, but it must match on both sides.
BUDDYNET_RELAY_ID=
#
# The handshake service's identity (its PUBLIC key). Step 1 in
# docker-compose.yml (`... run --rm handshake --role=handshake --key
# /var/lib/buddynet/id.key init`) prints it; `identity` instead of `init`
# prints it again later. The relay accepts only tickets signed by this key.
# Set BUDDYNET_RELAY_ID above BEFORE that step — compose refuses to read the
# file with it unset.
BUDDYNET_SERVER_KEY=
